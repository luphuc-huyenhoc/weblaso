# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/nguhanh_db"

# Session & Security (Minimum 32 random characters)
SESSION_SECRET="your-super-secret-random-hex-string-here"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Timezone Policy (Immutable Baseline)
TIMEZONE_POLICY="UTC+07-fixed"
NODE_ENV="production"

# Payment Configuration
PAYMENT_PROVIDER="MOCK" # MOCK, VNPAY, STRIPE
PAYMENT_WEBHOOK_SECRET="your-webhook-secret-here"
